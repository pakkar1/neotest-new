# =====================================================================
# NeoTest — contoh variabel lingkungan. JANGAN menyimpan berkas .env di Git.
# Salin menjadi .env (lokal) atau isi di Vercel → Project → Settings →
# Environment Variables untuk Production/Preview.
# =====================================================================

# ---------------------------------------------------------------------
# Mode data
# demo      : data disimpan pada berkas JSON (.data/neotest-demo.json).
#             Cocok untuk pengembangan & pratinjau. Tidak untuk produksi.
# firebase  : Firestore + Firebase Authentication via Admin SDK.
# ---------------------------------------------------------------------
NEOTEST_DATA_DRIVER=demo

# ---------------------------------------------------------------------
# Keamanan sesi & token ujian (WAJIB pada mode firebase)
# Buat nilai acak: openssl rand -base64 48
# ---------------------------------------------------------------------
NEOTEST_SESSION_SECRET=
NEOTEST_TOKEN_PEPPER=

# Origin publik aplikasi (untuk CORS). Contoh: https://neotest.vercel.app
NEOTEST_PUBLIC_ORIGIN=
# Daftar origin tambahan yang diizinkan, dipisahkan koma (opsional).
NEOTEST_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Firebase Admin SDK (server saja). Pilih SALAH SATU cara:
# 1) Satu baris JSON service account
# 2) Tiga variabel terpisah
# ---------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------
# Firebase Web SDK (publik, aman dikirim ke browser melalui /api/config).
# Diperlukan hanya pada mode firebase untuk login Firebase Auth.
# ---------------------------------------------------------------------
NEOTEST_FIREBASE_API_KEY=
NEOTEST_FIREBASE_AUTH_DOMAIN=
NEOTEST_FIREBASE_PROJECT_ID=
NEOTEST_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# Firebase App Check (opsional). Kunci situs reCAPTCHA v3 untuk web.
# Jika diisi, frontend mengaktifkan App Check; pastikan juga enforcement
# di Firebase Console.
# ---------------------------------------------------------------------
VITE_FIREBASE_APPCHECK_KEY=

# ---------------------------------------------------------------------
# Cron / sweep otomatis pengerjaan kedaluwarsa (opsional).
# Kirim header x-cron-secret: <nilai> ke GET /api/attempts?action=sweep
# ---------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------
# Pengembangan lokal
# ---------------------------------------------------------------------
# Lokasi berkas data demo (default: .data/neotest-demo.json)
NEOTEST_DATA_FILE=
